{
  "name": "aavoraa-lead-agent",
  "productName": "AAVORAA Lead Agent",
  "version": "1.5.0",
  "description": "AAVORAA Lead Agent - finds, pitches, follows up and qualifies leads",
  "main": "main.js",
  "author": "AAVORAA",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js",
    "dist": "electron-builder --win dir --x64"
  },
  "build": {
    "appId": "com.aavoraa.leadagent",
    "productName": "AAVORAA Lead Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "linkedin-bot.js",
      "search-window.js",
      "server/**",
      "ui/**",
      "assets/**",
      "package.json",
      "START HERE.md"
    ],
    "win": {
      "target": [
        "dir",
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icon.png"
    },
    "asar": true,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AAVORAA Lead Agent",
      "artifactName": "AAVORAA_Lead_Agent_Setup_${version}.exe",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "express": "^4.22.3",
    "google-auth-library": "^11.3.4",
    "imapflow": "^2.12.2",
    "mailparser": "^3.15.0",
    "nodemailer": "^10.6.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
